<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="#FF6A88"
        android:centerColor="#FF9A8B"
        android:endColor="#FFD1C1"
        android:angle="0"/>

    <!-- rounded corners -->
    <corners android:radius="12dp"/>

    <!-- border -->
    <stroke
        android:width="1dp"
        android:color="#88FFFFFF"/>

    <!-- padding inside shape (used by TextView if background) -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp"/>
</shape>